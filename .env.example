# SwapKit API Configuration
VITE_SWAPKIT_API_KEY=your_swapkit_api_key_here

# WalletConnect Configuration
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Blockchair API (for UTXO chains)
VITE_BLOCKCHAIR_API_KEY=your_blockchair_api_key_here

# Custom RPC URLs (optional)
VITE_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
VITE_AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org
VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# Environment Settings
VITE_USE_TESTNET=false